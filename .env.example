# Copy to .env and fill in.

# Postgres connection string. On Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=postgres://postgres@localhost:5432/meetspot
# Set to 1 when connecting to Supabase or another hosted database.
DATABASE_SSL=0

# Long random string used to hash sign-in codes and sessions. Generate with: openssl rand -hex 32
SECRET=change-me

PORT=3000
APP_URL=http://localhost:3000

# Local testing only: shows the sign-in code on screen instead of emailing it. Never 1 in production.
DEV_SHOW_CODES=1

# Email for sign-in codes (resend.com). Leave blank to print emails to the server log.
RESEND_API_KEY=
EMAIL_FROM=MeetSpot <login@yourdomain.com>

# Supabase sign-in for Google and Apple (Project Settings → API). Leave blank to use email codes only.
# SUPABASE_JWT_SECRET is only needed for older projects that still use the legacy JWT secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Where uploaded photos are stored.
UPLOAD_DIR=./uploads

# Optional: store photos in Supabase Storage instead of local disk (recommended on Render/Railway).
# Create a PUBLIC bucket named "photos" in Supabase → Storage. The service role key is secret: server only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos
